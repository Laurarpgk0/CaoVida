{
  "expo": {
    "name": "CaoVida",
    "slug": "CaoVida",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "caovida",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {},
      "predictiveBackGestureEnabled": false,
      "package": "com.lauragomes10.CaoVida"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Confirmar sua entrada no aplicativo."
        }
      ],

      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fefa2ca9-8b96-4944-b576-e89bb85ae27c"
      }
    }
  }
}
