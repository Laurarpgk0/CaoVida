{
  "expo": {
    "name": "CaoVida",
    "slug": "CaoVida",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "caovida",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {},
      "predictiveBackGestureEnabled": false,
      "package": "com.lauragomes10.CaoVida",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Confirmar sua entrada no aplicativo."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./src/assets/evento.wav"
          ]
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fefa2ca9-8b96-4944-b576-e89bb85ae27c"
      }
    },
    "owner": "lauragomes10"
  }
}
